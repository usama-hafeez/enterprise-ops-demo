{
  "name": "enterprise-ops-demo",
  "version": "0.1.0",
  "private": true,
  "description": "The same requisition pipeline, naive vs optimized - measured on query count, wall-clock time, and peak memory.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"benchmarks/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"benchmarks/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0"
  }
}
