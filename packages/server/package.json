{
  "name": "@enterprise-ops/server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API binding the shared pipeline to MySQL 8: run endpoints, streamed CSV export, migrations, seed.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "start": "node dist/main.js",
    "migration:run": "node dist/db/run-migrations.js",
    "seed": "node dist/seed/run-seed.js"
  },
  "dependencies": {
    "@enterprise-ops/core": "0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "dotenv": "^16.4.0",
    "mysql2": "^3.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5"
  }
}
