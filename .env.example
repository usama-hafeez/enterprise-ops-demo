# Copy to .env - these defaults work with docker-compose.yml as-is.
# Local demo credentials only. Nothing here is a real secret.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=demo
MYSQL_PASSWORD=demo_local_only
MYSQL_DATABASE=enterprise_ops
MYSQL_ROOT_PASSWORD=root_local_only

SERVER_PORT=3000
WEB_PORT=4200

# Seed volumes (deterministic - same seed, same data)
SEED=42
SEED_REQUISITIONS=500
SEED_PRODUCTS=12500
SEED_CUSTOMERS=200
SEED_INVOICES=10000
SEED_PAYMENTS=2000
